theme_override_colors/font_color = Color(1, 0.85, 0.7, 1)
theme_override_font_sizes/font_size = 11
text = "SPIKES — floor hazards. -1 life on contact, brief invincibility lets you keep running. Time your jumps to clear them."
autowrap_mode = 2

[node name="ChestIcon" type="TextureRect" parent="CenterPanel/MarginContainer/OuterVBox/ScrollContainer/ContentVBox/Grid"]

[ext_resource type="Theme" path="res://assets/default_theme.tres" id="97_theme"]
[ext_resource type="Script" path="res://scripts/OptionalBGM.gd" id="2_bgm"]

[node name="WinScreen" type="Control"]
theme = ExtResource("97_theme")
layout_mode = 3
